{
  "name": "@mateusseiboth/ts-decorators",
  "version": "2.0.0-rc.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusseiboth/ts-decorators.git"
  },
  "bin": {
    "ts-decorators": "./src/cli/index.ts"
  },
  "files": [
    "index.ts",
    "types.d.ts",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "module": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./testing": "./src/testing/prisma8Fakes.ts",
    "./oxlint": "./src/oxlint/no-enum.mjs"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt src tests index.ts types.d.ts package.json",
    "format:check": "oxfmt --check src tests index.ts types.d.ts package.json"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@types/bun": "latest",
    "handlebars": "^4.7.9",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pdf-lib": ">=1.17.0",
    "playwright": ">=1.49.0",
    "sharp": ">=0.33.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "pdf-lib": ">=1.17.0",
    "playwright": ">=1.49.0",
    "reflect-metadata": "^0.2.2",
    "sharp": ">=0.33.0",
    "typescript": "^7.0.2",
    "zod": "^4.3.5"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "handlebars": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  }
}
