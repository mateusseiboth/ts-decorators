{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "singleAttributePerLine": false,
  "objectWrap": "preserve",
  "sortPackageJson": true,
  "sortImports": {
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"]],
    "newlinesBetween": true
  }
}
